+// Hexlith oracle hooks: scripted input, framebuffer captures and batch runs
+// of Azahar's own hardware code on cases Hexlith generates. Licensed as the
+// rest of Azahar, GPLv2 or any later version.
+
+#pragma once
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+
+namespace Hexlith {
+
+// Called at every vertical blank of the top screen, once the interrupts are
+// signalled and the framebuffers for the frame are chosen.
+void OnVBlank(Core::System& system);
+
+// The buttons the input script holds in the current frame, as HID pad bits.
+u32 ScriptedButtons();
+
+} // namespace Hexlith
