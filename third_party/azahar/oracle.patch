+// Hexlith oracle hooks. Licensed as the rest of Azahar, GPLv2 or any later
+// version.
+//
+// Three environment variables switch them on, each independently:
+//
+//   HEXLITH_INPUT=<file>       the player's input, in Hexlith's input script
+//                              format (tap, press and release of buttons), by
+//                              vertical blank.
+//   HEXLITH_CAPTURE_DIR=<dir>  with HEXLITH_CAPTURE_FRAMES=<n,n,...>, writes
+//                              both screens' framebuffers at those frames and
+//                              quits after the last.
+//   HEXLITH_ORACLE_DIR=<dir>   at the first vertical blank, runs the cases in
+//                              the directory through Azahar's own code, writes
+//                              the results beside them, and quits.
+
+#include "core/hexlith_oracle.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "core/core.h"
+#include "core/hle/service/cam/y2r_u.h"
+#include "core/hw/y2r.h"
+#include "core/memory.h"
+#include "video_core/gpu.h"
+#include "video_core/pica/pica_core.h"
+
+namespace Hexlith {
+namespace {
+
+u64 frame = 0;
+
+std::string Environment(const char* name) {
+    const char* value = std::getenv(name);
+    return value == nullptr ? std::string{} : std::string{value};
+}
+
+// Input ---------------------------------------------------------------------
+
+// HID pad bits by Hexlith's button names. Source: PadState in hid.h.
+const std::map<std::string, u32> ButtonBits = {
+    {"a", 1u << 0},      {"b", 1u << 1},     {"select", 1u << 2}, {"start", 1u << 3},
+    {"right", 1u << 4},  {"left", 1u << 5},  {"up", 1u << 6},     {"down", 1u << 7},
+    {"r", 1u << 8},      {"l", 1u << 9},     {"x", 1u << 10},     {"y", 1u << 11},
+};
+
+// The buttons held in each frame, from the frame they change on.
+struct Script {
+    bool loaded = false;
+    std::map<u64, u32> held_from;
+};
+
+Script LoadScript() {
+    Script script;
+    script.loaded = true;
+    const std::string path = Environment("HEXLITH_INPUT");
+    if (path.empty()) {
+        return script;
+    }
+    std::ifstream file(path);
+    std::map<u64, std::vector<std::pair<u32, bool>>> changes;
+    std::string line;
+    while (std::getline(file, line)) {
+        line = line.substr(0, line.find('#'));
+        std::istringstream words(line);
+        u64 at = 0;
+        std::string action;
+        if (!(words >> at >> action)) {
+            continue;
+        }
+        u32 bits = 0;
+        u64 length = 4;
+        std::string word;
+        while (words >> word) {
+            if (word == "for") {
+                words >> length;
+            } else if (ButtonBits.count(word) != 0) {
+                bits |= ButtonBits.at(word);
+            }
+        }
+        if (action == "press" || action == "tap") {
+            changes[at].push_back({bits, true});
+        }
+        if (action == "release") {
+            changes[at].push_back({bits, false});
+        }
+        if (action == "tap") {
+            changes[at + length].push_back({bits, false});
+        }
+    }
+    u32 held = 0;
+    for (const auto& [at, list] : changes) {
+        for (const auto& [bits, down] : list) {
+            held = down ? (held | bits) : (held & ~bits);
+        }
+        script.held_from[at] = held;
+    }
+    return script;
+}
+
+// Captures --------------------------------------------------------------------
+
+std::set<u64> CaptureFrames() {
+    std::set<u64> frames;
+    std::stringstream list(Environment("HEXLITH_CAPTURE_FRAMES"));
+    std::string item;
+    while (std::getline(list, item, ',')) {
+        if (!item.empty()) {
+            frames.insert(std::stoull(item));
+        }
+    }
+    return frames;
+}
+
+// Both screens as the LCD shows them: the framebuffer the configuration
+// selects, its format and stride, 400 and 320 rows of 240 pixels.
+void Capture(Core::System& system, const std::string& directory) {
+    const auto& regs = system.GPU().PicaCore().regs;
+    constexpr u32 Rows[2] = {400, 320};
+    for (u32 screen = 0; screen < 2; ++screen) {
+        const auto& config = regs.framebuffer_config[screen];
+        const u32 address =
+            config.second_fb_active ? config.address_left2 : config.address_left1;
+        const u32 size = config.stride * Rows[screen];
+        const u8* bytes = system.Memory().GetPhysicalPointer(address);
+        const std::string name = directory + "/frame-" + std::to_string(frame) + "-" +
+                                 (screen == 0 ? "top" : "bottom");
+        std::ofstream out(name + ".bin", std::ios::binary);
+        if (bytes != nullptr) {
+            out.write(reinterpret_cast<const char*>(bytes), size);
+        }
+        std::ofstream info(name + ".txt");
+        info << "address " << std::hex << address << "\nformat " << config.format
+             << "\nstride " << std::dec << config.stride << "\nrows " << Rows[screen] << '\n';
+    }
+}
+
+// Y2R cases -------------------------------------------------------------------
+
+// Where the cases' buffers are put: VRAM, which every application maps at
+// 0x1F000000, far from anything the game has drawn by its first frame.
+constexpr VAddr InputAddress = 0x1F000000;
+constexpr VAddr OutputAddress = 0x1F100000;
+
+template <typename T>
+T Take(std::istream& in) {
+    T value{};
+    in.read(reinterpret_cast<char*>(&value), sizeof(value));
+    return value;
+}
+
+std::vector<u8> TakeBytes(std::istream& in) {
+    std::vector<u8> bytes(Take<u32>(in));
+    in.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    return bytes;
+}
+
+// A buffer of one sample or one pixel a unit and no gap, so that any size
+// divides into units.
+Service::Y2R::ConversionBuffer Buffer(VAddr address, u32 size, u16 unit) {
+    Service::Y2R::ConversionBuffer buffer{};
+    buffer.address = address;
+    buffer.image_size = size;
+    buffer.transfer_unit = unit;
+    buffer.gap = 0;
+    return buffer;
+}
+
+// y2r-cases.bin, a count then each case: input format, output format,
+// rotation and block alignment as bytes, the width and the lines as
+// halfwords, eight signed halfword coefficients, the alpha and three bytes of
+// padding, then the Y, U, V and YUYV buffers as they sit in memory, each a
+// word of length and its bytes. y2r-results.bin answers each with a word of
+// length and the output bytes.
+void RunY2r(Core::System& system, const std::string& directory) {
+    std::ifstream in(directory + "/y2r-cases.bin", std::ios::binary);
+    if (!in) {
+        return;
+    }
+    std::ofstream out(directory + "/y2r-results.bin", std::ios::binary);
+    Memory::MemorySystem& memory = system.Memory();
+    const u32 count = Take<u32>(in);
+    for (u32 index = 0; index < count; ++index) {
+        Service::Y2R::ConversionConfiguration cvt{};
+        cvt.input_format = static_cast<Service::Y2R::InputFormat>(Take<u8>(in));
+        cvt.output_format = static_cast<Service::Y2R::OutputFormat>(Take<u8>(in));
+        cvt.rotation = static_cast<Service::Y2R::Rotation>(Take<u8>(in));
+        cvt.block_alignment = static_cast<Service::Y2R::BlockAlignment>(Take<u8>(in));
+        cvt.input_line_width = Take<u16>(in);
+        cvt.input_lines = Take<u16>(in);
+        for (auto& coefficient : cvt.coefficients) {
+            coefficient = Take<s16>(in);
+        }
+        cvt.alpha = Take<u8>(in);
+        Take<u8>(in);
+        Take<u16>(in);
+
+        const bool wide = cvt.input_format == Service::Y2R::InputFormat::YUV422_Indiv16 ||
+                          cvt.input_format == Service::Y2R::InputFormat::YUV420_Indiv16;
+        const u16 sample = wide ? 2 : 1;
+        VAddr next = InputAddress;
+        Service::Y2R::ConversionBuffer* planes[4] = {&cvt.src_Y, &cvt.src_U, &cvt.src_V,
+                                                     &cvt.src_YUYV};
+        for (auto* plane : planes) {
+            const std::vector<u8> bytes = TakeBytes(in);
+            if (!bytes.empty()) {
+                memory.WriteBlock(next, bytes.data(), bytes.size());
+            }
+            *plane = Buffer(next, static_cast<u32>(bytes.size()), sample);
+            next += 0x10000;
+        }
+        static constexpr u16 PixelBytes[4] = {4, 3, 2, 2};
+        const u16 pixel = PixelBytes[static_cast<u32>(cvt.output_format) & 3];
+        const u32 output_size = cvt.input_line_width * cvt.input_lines * pixel;
+        cvt.dst = Buffer(OutputAddress, output_size, pixel);
+
+        HW::Y2R::PerformConversion(memory, cvt);
+
+        std::vector<u8> result(output_size);
+        memory.ReadBlock(OutputAddress, result.data(), result.size());
+        const u32 length = output_size;
+        out.write(reinterpret_cast<const char*>(&length), sizeof(length));
+        out.write(reinterpret_cast<const char*>(result.data()), result.size());
+    }
+}
+
+void RunOracle(Core::System& system, const std::string& directory) {
+    RunY2r(system, directory);
+    std::ofstream(directory + "/done.txt") << "done\n";
+}
+
+} // namespace
+
+void OnVBlank(Core::System& system) {
+    ++frame;
+
+    static const std::string oracle = Environment("HEXLITH_ORACLE_DIR");
+    if (!oracle.empty()) {
+        RunOracle(system, oracle);
+        std::fflush(nullptr);
+        std::_Exit(0);
+    }
+
+    static const std::string capture = Environment("HEXLITH_CAPTURE_DIR");
+    static const std::set<u64> frames = CaptureFrames();
+    if (!capture.empty() && frames.count(frame) != 0) {
+        Capture(system, capture);
+        if (frame == *frames.rbegin()) {
+            std::fflush(nullptr);
+            std::_Exit(0);
+        }
+    }
+}
+
+u32 ScriptedButtons() {
+    static const Script script = LoadScript();
+    const auto after = script.held_from.upper_bound(frame);
+    if (after == script.held_from.begin()) {
+        return 0;
+    }
+    return std::prev(after)->second;
+}
+
+} // namespace Hexlith
