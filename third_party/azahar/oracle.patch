+namespace Hexlith {
+namespace {
+
+u64 frame = 0;
+
+std::string Environment(const char* name) {
+    const char* value = std::getenv(name);
+    return value == nullptr ? std::string{} : std::string{value};
+}
+
+// Input ---------------------------------------------------------------------
+
+// HID pad bits by Hexlith's button names. Source: PadState in hid.h.
+const std::map<std::string, u32> ButtonBits = {
+    {"a", 1u << 0},      {"b", 1u << 1},     {"select", 1u << 2}, {"start", 1u << 3},
+    {"right", 1u << 4},  {"left", 1u << 5},  {"up", 1u << 6},     {"down", 1u << 7},
+    {"r", 1u << 8},      {"l", 1u << 9},     {"x", 1u << 10},     {"y", 1u << 11},
+};
+
+// The buttons held in each frame, from the frame they change on.
+struct Script {
+    bool loaded = false;
+    std::map<u64, u32> held_from;
+};
+
+Script LoadScript() {
+    Script script;
+    script.loaded = true;
+    const std::string path = Environment("HEXLITH_INPUT");
+    if (path.empty()) {
+        return script;
+    }
+    std::ifstream file(path);
+    std::map<u64, std::vector<std::pair<u32, bool>>> changes;
+    std::string line;
+    while (std::getline(file, line)) {
+        line = line.substr(0, line.find('#'));
+        std::istringstream words(line);
+        u64 at = 0;
+        std::string action;
+        if (!(words >> at >> action)) {
+            continue;
+        }
+        u32 bits = 0;
+        u64 length = 4;
+        std::string word;
+        while (words >> word) {
+            if (word == "for") {
+                words >> length;
+            } else if (ButtonBits.count(word) != 0) {
+                bits |= ButtonBits.at(word);
+            }
+        }
+        if (action == "press" || action == "tap") {
+            changes[at].push_back({bits, true});
+        }
+        if (action == "release") {
+            changes[at].push_back({bits, false});
+        }
+        if (action == "tap") {
+            changes[at + length].push_back({bits, false});
+        }
+    }
+    u32 held = 0;
+    for (const auto& [at, list] : changes) {
+        for (const auto& [bits, down] : list) {
+            held = down ? (held | bits) : (held & ~bits);
+        }
+        script.held_from[at] = held;
+    }
+    return script;
+}
+
+// Captures --------------------------------------------------------------------
+
+std::set<u64> CaptureFrames() {
+    std::set<u64> frames;
+    std::stringstream list(Environment("HEXLITH_CAPTURE_FRAMES"));
+    std::string item;
+    while (std::getline(list, item, ',')) {
+        if (!item.empty()) {
+            frames.insert(std::stoull(item));
+        }
+    }
+    return frames;
+}
+
+// Both screens as the LCD shows them: the framebuffer the configuration
+// selects, its format and stride, 400 and 320 rows of 240 pixels.
+void Capture(Core::System& system, const std::string& directory) {
+    const auto& regs = system.GPU().PicaCore().regs;
+    constexpr u32 Rows[2] = {400, 320};
+    for (u32 screen = 0; screen < 2; ++screen) {
+        const auto& config = regs.framebuffer_config[screen];
+        const u32 address =
+            config.second_fb_active ? config.address_left2 : config.address_left1;
+        const u32 size = config.stride * Rows[screen];
+        const u8* bytes = system.Memory().GetPhysicalPointer(address);
+        const std::string name = directory + "/frame-" + std::to_string(frame) + "-" +
+                                 (screen == 0 ? "top" : "bottom");
+        std::ofstream out(name + ".bin", std::ios::binary);
+        if (bytes != nullptr) {
+            out.write(reinterpret_cast<const char*>(bytes), size);
+        }
+        std::ofstream info(name + ".txt");
+        info << "address " << std::hex << address << "\nformat " << config.format
+             << "\nstride " << std::dec << config.stride << "\nrows " << Rows[screen] << '\n';
+    }
+}
+
+// Y2R cases -------------------------------------------------------------------
+
+// Where the cases' buffers are put: VRAM, which every application maps at
+// 0x1F000000, far from anything the game has drawn by its first frame.
+constexpr VAddr InputAddress = 0x1F000000;
+constexpr VAddr OutputAddress = 0x1F100000;
+
+template <typename T>
+T Take(std::istream& in) {
+    T value{};
+    in.read(reinterpret_cast<char*>(&value), sizeof(value));
+    return value;
+}
+
+std::vector<u8> TakeBytes(std::istream& in) {
+    std::vector<u8> bytes(Take<u32>(in));
+    in.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    return bytes;
+}
+
+// A buffer of one sample or one pixel a unit and no gap, so that any size
+// divides into units.
+Service::Y2R::ConversionBuffer Buffer(VAddr address, u32 size, u16 unit) {
+    Service::Y2R::ConversionBuffer buffer{};
+    buffer.address = address;
+    buffer.image_size = size;
+    buffer.transfer_unit = unit;
+    buffer.gap = 0;
+    return buffer;
+}
+
+// y2r-cases.bin, a count then each case: input format, output format,
+// rotation and block alignment as bytes, the width and the lines as
+// halfwords, eight signed halfword coefficients, the alpha and three bytes of
+// padding, then the Y, U, V and YUYV buffers as they sit in memory, each a
+// word of length and its bytes. y2r-results.bin answers each with a word of
+// length and the output bytes.
+void RunY2r(Core::System& system, const std::string& directory) {
+    std::ifstream in(directory + "/y2r-cases.bin", std::ios::binary);
+    if (!in) {
+        return;
+    }
+    std::ofstream out(directory + "/y2r-results.bin", std::ios::binary);
+    Memory::MemorySystem& memory = system.Memory();
+    const u32 count = Take<u32>(in);
+    for (u32 index = 0; index < count; ++index) {
+        Service::Y2R::ConversionConfiguration cvt{};
+        cvt.input_format = static_cast<Service::Y2R::InputFormat>(Take<u8>(in));
+        cvt.output_format = static_cast<Service::Y2R::OutputFormat>(Take<u8>(in));
+        cvt.rotation = static_cast<Service::Y2R::Rotation>(Take<u8>(in));
+        cvt.block_alignment = static_cast<Service::Y2R::BlockAlignment>(Take<u8>(in));
+        cvt.input_line_width = Take<u16>(in);
+        cvt.input_lines = Take<u16>(in);
+        for (auto& coefficient : cvt.coefficients) {
+            coefficient = Take<s16>(in);
+        }
+        cvt.alpha = Take<u8>(in);
+        Take<u8>(in);
+        Take<u16>(in);
+
+        const bool wide = cvt.input_format == Service::Y2R::InputFormat::YUV422_Indiv16 ||
+                          cvt.input_format == Service::Y2R::InputFormat::YUV420_Indiv16;
+        const u16 sample = wide ? 2 : 1;
+        VAddr next = InputAddress;
+        Service::Y2R::ConversionBuffer* planes[4] = {&cvt.src_Y, &cvt.src_U, &cvt.src_V,
+                                                     &cvt.src_YUYV};
+        for (auto* plane : planes) {
+            const std::vector<u8> bytes = TakeBytes(in);
+            if (!bytes.empty()) {
+                memory.WriteBlock(next, bytes.data(), bytes.size());
+            }
+            *plane = Buffer(next, static_cast<u32>(bytes.size()), sample);
+            next += 0x10000;
+        }
+        static constexpr u16 PixelBytes[4] = {4, 3, 2, 2};
+        const u16 pixel = PixelBytes[static_cast<u32>(cvt.output_format) & 3];
+        const u32 output_size = cvt.input_line_width * cvt.input_lines * pixel;
+        cvt.dst = Buffer(OutputAddress, output_size, pixel);
+
+        HW::Y2R::PerformConversion(memory, cvt);
+
+        std::vector<u8> result(output_size);
+        memory.ReadBlock(OutputAddress, result.data(), result.size());
+        const u32 length = output_size;
+        out.write(reinterpret_cast<const char*>(&length), sizeof(length));
+        out.write(reinterpret_cast<const char*>(result.data()), result.size());
+    }
+}
+
+
+// PICA command lists ----------------------------------------------------------
+
+bool pica_oracle_active = false;
+
+struct PicaEvent {
+    u8 kind;
+    u64 registers;
+    u64 extra;
+};
+std::vector<PicaEvent> pica_events;
+
+// FNV-1a, 64 bits, over bytes: Hexlith's tool hashes the same bytes the same
+// way, so that two states compare by a word each.
+u64 Hash(const void* data, std::size_t size, u64 hash = 0xCBF29CE484222325ULL) {
+    const u8* bytes = static_cast<const u8*>(data);
+    for (std::size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 0x100000001B3ULL;
+    }
+    return hash;
+}
+
+constexpr u32 InternalRegisters = 0x300;
+constexpr u32 ListScratch = 0x185C0000;
+
+// Back to a state both sides can start from: every internal register zero
+// but the interrupt setup Nintendo's code leaves, empty shader memories,
+// uniforms, attributes and tables.
+void ResetPica(Pica::PicaCore& pica) {
+    pica.regs.internal.reg_array.fill(0);
+    pica.regs.internal.irq_compare = 0x12345678;
+    pica.regs.internal.irq_mask = 0xFFFFFFF0;
+    pica.regs.internal.irq_autostop = 1;
+    for (Pica::ShaderSetup* setup : {&pica.vs_setup, &pica.gs_setup}) {
+        setup->UpdateProgramCode(Pica::ProgramCode{});
+        setup->UpdateSwizzleData(Pica::SwizzleData{});
+        setup->uniforms = Pica::Uniforms{};
+        setup->uniform_queue.Reset();
+    }
+    pica.input_default_attributes = Pica::AttributeBuffer{};
+    pica.immediate.input_vertex = Pica::AttributeBuffer{};
+    pica.immediate.Reset();
+    for (auto& table : pica.lighting.luts) {
+        for (auto& entry : table) {
+            entry.raw = 0;
+        }
+    }
+    for (auto& entry : pica.fog.lut) {
+        entry.raw = 0;
+    }
+    for (auto& entry : pica.proctex.noise_table) entry.raw = 0;
+    for (auto& entry : pica.proctex.color_map_table) entry.raw = 0;
+    for (auto& entry : pica.proctex.alpha_map_table) entry.raw = 0;
+    for (auto& entry : pica.proctex.color_table) entry.raw = 0;
+    for (auto& entry : pica.proctex.color_diff_table) entry.raw = 0;
+}
+
+u64 HashUniforms(const Pica::ShaderSetup& setup) {
+    u64 hash = 0xCBF29CE484222325ULL;
+    for (const auto& uniform : setup.uniforms.f) {
+        for (u32 c = 0; c < 4; ++c) {
+            const float value = uniform[c].ToFloat32();
+            hash = Hash(&value, sizeof(value), hash);
+        }
+    }
+    return hash;
+}
+
+u64 HashBools(const Pica::ShaderSetup& setup) {
+    u32 bits = 0;
+    for (u32 i = 0; i < 16; ++i) {
+        bits |= (setup.uniforms.b[i] ? 1u : 0u) << i;
+    }
+    return Hash(&bits, sizeof(bits));
+}
+
+u64 HashInts(const Pica::ShaderSetup& setup) {
+    u64 hash = 0xCBF29CE484222325ULL;
+    for (const auto& value : setup.uniforms.i) {
+        const u32 word = value.x | (value.y << 8) | (value.z << 16) | (value.w << 24);
+        hash = Hash(&word, sizeof(word), hash);
+    }
+    return hash;
+}
+
+u64 HashAttributes(const Pica::AttributeBuffer& buffer) {
+    u64 hash = 0xCBF29CE484222325ULL;
+    for (const auto& attribute : buffer) {
+        for (u32 c = 0; c < 4; ++c) {
+            const float value = attribute[c].ToFloat32();
+            hash = Hash(&value, sizeof(value), hash);
+        }
+    }
+    return hash;
+}
+
+template <typename Table>
+u64 HashRaw(const Table& table, u64 hash = 0xCBF29CE484222325ULL) {
+    for (const auto& entry : table) {
+        const u32 raw = entry.raw;
+        hash = Hash(&raw, sizeof(raw), hash);
+    }
+    return hash;
+}
+
+// The sixteen section hashes docs/pica-commands.md lists, in its order.
+std::vector<u64> HashState(Pica::PicaCore& pica) {
+    std::vector<u64> hashes;
+    hashes.push_back(Hash(pica.regs.internal.reg_array.data(), InternalRegisters * sizeof(u32)));
+    for (Pica::ShaderSetup* setup : {&pica.vs_setup, &pica.gs_setup}) {
+        hashes.push_back(Hash(setup->GetProgramCode().data(), sizeof(Pica::ProgramCode)));
+        hashes.push_back(Hash(setup->GetSwizzleData().data(), sizeof(Pica::SwizzleData)));
+        hashes.push_back(HashUniforms(*setup));
+        hashes.push_back(HashBools(*setup));
+        hashes.push_back(HashInts(*setup));
+    }
+    hashes.push_back(HashAttributes(pica.input_default_attributes));
+    u64 lighting = 0xCBF29CE484222325ULL;
+    for (const auto& table : pica.lighting.luts) {
+        lighting = HashRaw(table, lighting);
+    }
+    hashes.push_back(lighting);
+    hashes.push_back(HashRaw(pica.fog.lut));
+    u64 proctex = HashRaw(pica.proctex.noise_table);
+    proctex = HashRaw(pica.proctex.color_map_table, proctex);
+    proctex = HashRaw(pica.proctex.alpha_map_table, proctex);
+    proctex = HashRaw(pica.proctex.color_table, proctex);
+    proctex = HashRaw(pica.proctex.color_diff_table, proctex);
+    hashes.push_back(proctex);
+    hashes.push_back(HashAttributes(pica.immediate.input_vertex));
+    return hashes;
+}
+
+// pica-cases.bin: a word with the count of cases; each case a word with its
+// count of steps; each step a word with a count of memory blocks, each block
+// its physical address, its length and its bytes, then a command list as its
+// length and bytes. Every case starts from ResetPica. pica-results.bin
+// answers each step with its events and the section hashes.
+void RunPica(Core::System& system, const std::string& directory) {
+    std::ifstream in(directory + "/pica-cases.bin", std::ios::binary);
+    if (!in) {
+        return;
+    }
+    std::ofstream out(directory + "/pica-results.bin", std::ios::binary);
+    Pica::PicaCore& pica = system.GPU().PicaCore();
+    Memory::MemorySystem& memory = system.Memory();
+    pica_oracle_active = true;
+    const u32 cases = Take<u32>(in);
+    for (u32 c = 0; c < cases; ++c) {
+        ResetPica(pica);
+        const u32 steps = Take<u32>(in);
+        for (u32 s = 0; s < steps; ++s) {
+            const u32 blocks = Take<u32>(in);
+            for (u32 b = 0; b < blocks; ++b) {
+                const u32 address = Take<u32>(in);
+                const std::vector<u8> bytes = TakeBytes(in);
+                u8* target = memory.GetPhysicalPointer(address);
+                if (target != nullptr) {
+                    std::memcpy(target, bytes.data(), bytes.size());
+                }
+            }
+            const std::vector<u8> list = TakeBytes(in);
+            std::memcpy(memory.GetPhysicalPointer(ListScratch), list.data(), list.size());
+            pica_events.clear();
+            pica.ProcessCmdList(ListScratch, static_cast<u32>(list.size()), false);
+
+            const u32 count = static_cast<u32>(pica_events.size());
+            out.write(reinterpret_cast<const char*>(&count), sizeof(count));
+            for (const PicaEvent& event : pica_events) {
+                out.write(reinterpret_cast<const char*>(&event.kind), sizeof(event.kind));
+                out.write(reinterpret_cast<const char*>(&event.registers), sizeof(event.registers));
+                out.write(reinterpret_cast<const char*>(&event.extra), sizeof(event.extra));
+            }
+            for (const u64 hash : HashState(pica)) {
+                out.write(reinterpret_cast<const char*>(&hash), sizeof(hash));
+            }
+            out.write(reinterpret_cast<const char*>(pica.regs.internal.reg_array.data()),
+                      InternalRegisters * sizeof(u32));
+        }
+    }
+    pica_oracle_active = false;
+}
+
+// Shader programs --------------------------------------------------------------
+
+template <typename T>
+void Put(std::ostream& out, const T& value) {
+    out.write(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+
+void TakeVectors(std::istream& in, Common::Vec4<Pica::f24>* vectors, std::size_t count) {
+    for (std::size_t i = 0; i < count; ++i) {
+        for (u32 c = 0; c < 4; ++c) {
+            vectors[i][c] = Pica::f24::FromFloat32(std::bit_cast<float>(Take<u32>(in)));
+        }
+    }
+}
+
+void PutVectors(std::ostream& out, const Common::Vec4<Pica::f24>* vectors, std::size_t count) {
+    for (std::size_t i = 0; i < count; ++i) {
+        for (u32 c = 0; c < 4; ++c) {
+            Put(out, std::bit_cast<u32>(vectors[i][c].ToFloat32()));
+        }
+    }
+}
+
+// shader-cases.bin: a word with the count of cases, then each case: a word
+// that is 0 for a vertex shader and 1 for a geometry shader, the entry point,
+// the output mask, 4096 words of code, 4096 of operand descriptors, 96
+// uniforms of four float32 bit patterns, the bool uniforms, the four integer
+// uniforms, then the registers as the run starts: 16 inputs, 16 temporaries,
+// two banks of 16 outputs, the output bank, a0.x, a0.y, aL and the two
+// condition flags as words. shader-results.bin answers each case with the
+// registers as the run leaves them, in the same layout, then the count of
+// primitives emitted and each as a word that is 1 if its winding was
+// reversed and its three vertices of 16 attributes.
+void RunShaders(const std::string& directory) {
+    std::ifstream in(directory + "/shader-cases.bin", std::ios::binary);
+    if (!in) {
+        return;
+    }
+    std::ofstream out(directory + "/shader-results.bin", std::ios::binary);
+    const u32 cases = Take<u32>(in);
+    auto setup = std::make_unique<Pica::ShaderSetup>();
+    auto code = std::make_unique<Pica::ProgramCode>();
+    auto descriptors = std::make_unique<Pica::SwizzleData>();
+    Pica::Shader::InterpreterEngine engine;
+    for (u32 c = 0; c < cases; ++c) {
+        const bool geometry = Take<u32>(in) != 0;
+        const u32 entry = Take<u32>(in);
+        const u32 output_mask = Take<u32>(in);
+        for (auto& word : *code) word = Take<u32>(in);
+        for (auto& word : *descriptors) word = Take<u32>(in);
+        setup->UpdateProgramCode(*code);
+        setup->UpdateSwizzleData(*descriptors);
+        TakeVectors(in, setup->uniforms.f.data(), 96);
+        const u32 bools = Take<u32>(in);
+        for (u32 i = 0; i < 16; ++i) setup->uniforms.b[i] = ((bools >> i) & 1) != 0;
+        for (u32 i = 0; i < 4; ++i) {
+            const u32 word = Take<u32>(in);
+            setup->uniforms.i[i] = Common::Vec4<u8>{static_cast<u8>(word), static_cast<u8>(word >> 8),
+                                                    static_cast<u8>(word >> 16), static_cast<u8>(word >> 24)};
+        }
+
+        auto unit = std::make_unique<Pica::GeometryShaderUnit>();
+        Pica::ShaderUnit& state = *unit;
+        if (!geometry) {
+            state.emitter_ptr = nullptr;
+        }
+        TakeVectors(in, state.input.data(), 16);
+        TakeVectors(in, state.temporary.data(), 16);
+        TakeVectors(in, state.output[0].data(), 16);
+        TakeVectors(in, state.output[1].data(), 16);
+        state.output_bank = Take<u32>(in) != 0;
+        for (auto& address : state.address_registers) address = static_cast<s32>(Take<u32>(in));
+        for (auto& condition : state.conditional_code) condition = Take<u32>(in) != 0;
+
+        std::vector<std::pair<bool, std::vector<Pica::AttributeBuffer>>> primitives;
+        bool reversed = false;
+        std::vector<Pica::AttributeBuffer> vertices;
+        unit->SetVertexHandlers(
+            [&](const Pica::AttributeBuffer& vertex) {
+                vertices.push_back(vertex);
+                if (vertices.size() == 3) {
+                    primitives.push_back({reversed, vertices});
+                    vertices.clear();
+                    reversed = false;
+                }
+            },
+            [&] { reversed = true; });
+        unit->emitter.output_mask = output_mask;
+        // Neither is initialised by the unit's constructor.
+        unit->emitter.emit_state.raw = 0;
+        unit->emitter.buffer = {};
+
+        engine.SetupBatch(*setup, entry);
+        engine.Run(*setup, state);
+
+        PutVectors(out, state.input.data(), 16);
+        PutVectors(out, state.temporary.data(), 16);
+        PutVectors(out, state.output[0].data(), 16);
+        PutVectors(out, state.output[1].data(), 16);
+        Put(out, static_cast<u32>(state.output_bank));
+        for (const auto address : state.address_registers) Put(out, static_cast<u32>(address));
+        for (const auto condition : state.conditional_code) Put(out, static_cast<u32>(condition));
+        Put(out, static_cast<u32>(primitives.size()));
+        for (const auto& [winding, primitive] : primitives) {
+            Put(out, static_cast<u32>(winding));
+            for (const auto& vertex : primitive) {
+                PutVectors(out, vertex.data(), 16);
+            }
+        }
+    }
+}
+
+void RunOracle(Core::System& system, const std::string& directory) {
+    RunY2r(system, directory);
+    RunPica(system, directory);
+    RunShaders(directory);
+    std::ofstream(directory + "/done.txt") << "done\n";
+}
+
+} // namespace
+
+void OnVBlank(Core::System& system) {
+    ++frame;
+
+    static const std::string oracle = Environment("HEXLITH_ORACLE_DIR");
+    if (!oracle.empty()) {
+        RunOracle(system, oracle);
+        std::fflush(nullptr);
+        std::_Exit(0);
+    }
+
+    static const std::string capture = Environment("HEXLITH_CAPTURE_DIR");
+    static const std::set<u64> frames = CaptureFrames();
+    if (!capture.empty() && frames.count(frame) != 0) {
+        Capture(system, capture);
+        if (frame == *frames.rbegin()) {
+            std::fflush(nullptr);
+            std::_Exit(0);
+        }
+    }
+}
+
+bool PicaOracleActive() {
+    return pica_oracle_active;
+}
+
+void NotePicaEvent(u8 kind, const u32* registers, const void* extra, std::size_t extra_size) {
+    // The data ports of the FIFOs are left out: when a command writes one
+    // several times, Azahar stores the last value before it handles the
+    // first, so what they hold in the middle of a command is not comparable.
+    std::array<u32, InternalRegisters> copy;
+    std::memcpy(copy.data(), registers, sizeof(copy));
+    static constexpr std::pair<u32, u32> Ports[] = {{0x0B0, 0x0B8}, {0x0E8, 0x0F0}, {0x1C8, 0x1D0}, {0x233, 0x236}, {0x291, 0x299}, {0x29C, 0x2A4}, {0x2A6, 0x2AE}, {0x2C1, 0x2C9}, {0x2CC, 0x2D4}, {0x2D6, 0x2DE}};
+    for (const auto& [first, end] : Ports) {
+        for (u32 id = first; id < end; ++id) {
+            copy[id] = 0;
+        }
+    }
+    pica_events.push_back(PicaEvent{kind, Hash(copy.data(), sizeof(copy)),
+                                    extra != nullptr ? Hash(extra, extra_size) : 0});
+}
+
+u32 ScriptedButtons() {
+    static const Script script = LoadScript();
+    const auto after = script.held_from.upper_bound(frame);
+    if (after == script.held_from.begin()) {
+        return 0;
+    }
+    return std::prev(after)->second;
+}
+
+} // namespace Hexlith
